{
  "manifest_version": 2,
  "name": "True Pinned Tabs",
  "version": "1.0.0",
  "description": "Saves pinned tabs to persistent storage and restores them on every startup, regardless of how Firefox last closed.",
  "permissions": [
    "tabs",
    "storage",
    "windows"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "true-pinned-tabs@local",
      "strict_min_version": "91.0",
      "update_url": "https://raw.githubusercontent.com/ConociendoAlmasMenosHastiadas/TruePinnedTabs/primarius/updates.json"
    }
  }
}
